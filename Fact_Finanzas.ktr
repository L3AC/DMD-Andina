    <connection>usuSQL</connection>
    <sql>SELECT
    LTRIM(RTRIM(Mes)) AS Mes,
    Ingresos, CostoVentas, GastosOperativos, UtilidadNeta,
    FlujoCaja, InversionesRealizadas, RetornoInversion,
    ABS(UtilidadNeta - (Ingresos - CostoVentas - GastosOperativos)) AS DifUtilidad
FROM stg.stg_Finanzas;</sql>
